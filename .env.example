# Postgres (matches docker-compose db service)
DATABASE_URL="postgresql://eseller:eseller@localhost:5432/eseller?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Checkout totals (optional overrides)
SHIPPING_FEE="5.00"
TAX_RATE="0.08"

# Optional persistent product image directory (default ./uploads)
# UPLOAD_DIR="./uploads"
